// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
/// Roles de la plataforma. Un estudiante practica; un administrador consulta usuarios y administra contenido (REQ-011).
enum Rol {
  estudiante
  admin
}

model Usuario {
  id        Int       @id @default(autoincrement())
  /// Nombre de usuario: con él se inicia sesión y es el alias público en ranking y comunidad. En minúsculas, único.
  username  String    @unique
  /// Correo: solo para recuperar el acceso (REQ-010). No se muestra a otros usuarios.
  email     String    @unique
  /// Hash scrypt ("scrypt$..."); nunca la contraseña en texto.
  password  String
  rol       Rol       @default(estudiante)
  /// REQ-008: el estudiante puede excluirse del ranking. Por defecto aparece, con su alias.
  visibleEnRanking Boolean @default(true)
  progreso  Progreso[]
  parciales ProgresoParcial[]
  creadoEn  DateTime  @default(now())
  /// REQ-021: versión de los términos que aceptó al registrarse y cuándo. Nulos en cuentas anteriores.
  terminosVersion     String?
  terminosAceptadosEn DateTime?
  neuronas     Int      @default(5)
  maxNeuronas  Int      @default(5)
  ultimaRecarga DateTime?
}
model Progreso {
  id         Int      @id @default(autoincrement())
  user       Usuario  @relation(fields: [userId], references: [id])
  userId     Int
  seccion    String
  nivel      String
  actividad  String
  completado Boolean
  score      Int
  tiempo     Int
  fecha      DateTime @default(now())

  @@unique([userId, seccion, nivel, actividad], name: "userId_seccion_nivel_actividad")
}

/// REQ-006: actividad a medias (ronda, puntos y vidas) para retomarla al volver a entrar con la misma cuenta.
/// Se borra al completar la actividad o al reiniciarla.
model ProgresoParcial {
  id          Int      @id @default(autoincrement())
  user        Usuario  @relation(fields: [userId], references: [id])
  userId      Int
  seccion     String
  nivel       String
  actividad   String
  estado      Json
  vidas       Int
  actualizado DateTime @updatedAt

  @@unique([userId, seccion, nivel, actividad], name: "userId_seccion_nivel_actividad")
}

/// REQ-011: contenido de las misiones. Un nivel agrupa actividades; cada actividad elige un juego por clave.
model Nivel {
  id          Int         @id @default(autoincrement())
  seccion     String
  /// Identificador en la URL ("1", "2"...).
  clave       String
  titulo      String
  texto       String
  objetivo    String
  orden       Int
  actividades Actividad[]

  @@unique([seccion, clave])
}

model Actividad {
  id          Int    @id @default(autoincrement())
  nivel       Nivel  @relation(fields: [nivelId], references: [id], onDelete: Cascade)
  nivelId     Int
  clave       String
  titulo      String
  descripcion String
  objetivo    String
  minutos     Int
  /// Clave del juego: reconocer | intruso | completa.
  juego       String
  /// string[] con las reglas y el ejemplo resuelto. Se validan con lib/contenido-schema.ts.
  reglas      Json
  ejemplo     Json
  orden       Int

  @@unique([nivelId, clave])
}
